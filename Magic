public class Magic {
// we will refer to myNumber as the original number (Task 2)
	public static void main(String[] args) {
		int myNumber = 98; // Task 1: set non-zero original number
		int stepOne = myNumber * myNumber; // Task 3
		int stepTwo = stepOne + myNumber; // Task 4
		int stepThree = stepTwo / myNumber; // Task 5
		int stepFour = stepThree + 17; // Task 6
		int stepFive = stepFour - myNumber; // Task 7
		int stepSix = stepFive / 6; // Task 8
		
		System.out.println(stepSix); // Task 9
	}
}
